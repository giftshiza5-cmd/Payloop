# PayLoop Smart Contracts Environment Variables Configuration Template
# Copy this file to '.env' and fill in your details.

# RPC URL for Polygon Amoy Testnet (fallback to official public RPC if omitted)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private Key of the deployer wallet address (without 0x prefix)
PRIVATE_KEY=

# Optional: Polygonscan API key for smart contract verification
POLYGONSCAN_API_KEY=
