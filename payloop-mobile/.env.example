# PayLoop Expo Mobile App Environment Variables Configuration Template
# Copy this file to '.env' and customize.
# Note: Variables accessed at runtime on the client side must be prefixed with 'EXPO_PUBLIC_'

# Firebase app identifiers (for database initialization and authentication)
FIREBASE_DATA_ID=
EXPO_PUBLIC_FIREBASE_DATA_ID=

# Backend API server URL endpoint
EXPO_PUBLIC_BACKEND_URL=http:/localhost:5000

# Blockchain JSON-RPC provider endpoint for Polygon Amoy
EXPO_PUBLIC_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
