# PayLoop Backend API Server Environment Variables Configuration Template
# Copy this file to '.env' and customize.

# Express Web Server listening port
PORT=5000

# JSON-RPC Node endpoint for chain interaction (Default: localhost Hardhat)
# For Polygon Amoy Testnet, set this to: https://rpc-amoy.polygon.technology
RPC_URL=http://127.0.0.1:8545

# Private Key of the relayer wallet that signs the contributeOnBehalf deposit transactions
# Default: Hardhat local accounts #0 private key
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Safaricom Daraja M-Pesa Sandbox API Credentials
# Replace these with your Daraja portal credentials for real callback routing
MPESA_CONSUMER_KEY=zId0IvJ0hNlGAWhC9ALfgduClberoy36xGGvM1B1xSqFC87y
MPESA_CONSUMER_SECRET=J87v4PrlRYoCwzwItSMGo9WTTVtRZCfBTVAv5MBOyHHEAdWXFpX2JwNur1rYuNqG
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Callback URL registered on Safaricom's Daraja portal for webhook delivery
# Must be a publicly accessible HTTPS URL (e.g. ngrok tunnel during development)
CALLBACK_URL=http://localhost:5000/api/mpesa/callback

# Firebase Configuration
# Used for storing pending payments data and sending push notifications to the mobile client
FIREBASE_DATA_ID=
FIREBASE_SERVICE_ACCOUNT=

# SMTP Email Configuration (Nodemailer)
# Configure these to enable real transactional email OTPs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
